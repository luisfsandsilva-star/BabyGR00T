# ==============================================================================
# .dockerignore - Exclude unnecessary files from Docker build context
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/

# Git
.git/
.gitignore
.gitattributes
.github/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/

# Data & Outputs (don't copy into image - mount as volumes instead)
data/
outputs/
checkpoints/
logs/
*.npz
*.npy
*.mp4
*.parquet
*.h5
*.hdf5

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Documentation
*.md
!README.md
docs/
assets/
media/

# Docker
Dockerfile
.dockerignore
docker-compose.yml

# Tests
tests/
.pytest_cache/
*.coverage

# OS
.DS_Store
Thumbs.db

# Temporary files
*.log
*.tmp
*.temp
tmp/
temp/

# Model weights (too large for image)
*.pth
*.pt
*.ckpt
*.safetensors
*.bin

# Cache
.cache/
*.cache

# Misc
kaggle/
cross_attn_*.png
cross_attn_*.npy
cross_attn_*.txt
*.deb
